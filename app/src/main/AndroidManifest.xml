<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 위치: GPS 절대속도/정확도 취득. 대략 위치만 부여되면 accuracy가 수백 m가 되어
         GPS 게이트가 상시 차단된다. 앱에서 FINE 부여 여부를 별도로 검사한다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- API 29+: 화면 꺼짐/앱 종료 상태에서도 FGS가 위치를 받기 위해 필요 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: foregroundServiceType과 짝이 되는 권한 선언이 필수 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- API 33+: FGS 알림 표시 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 경고 진동. TTS와 함께 경고의 주 전달 수단이므로 반드시 필요하다. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- wake-up 센서를 못 쓰는 기기에서 화면 꺼짐 시 수집 유지를 위한 선택적 수단.
         기본값은 OFF이며 사용자가 설정에서 켤 때만 사용한다. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 배터리 최적화 제외 요청 다이얼로그. Play 스토어 배포 시 정책 심사 대상이므로
         기본 경로는 시스템 설정 화면(ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS)으로 안내한다. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />

    <application
        android:name=".SafeDriveApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.SafeDrive">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafeDrive"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CSV/진단 파일을 사용자가 직접 공유할 때만 쓰는 경로. 앱이 스스로 보내지 않는다. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.DrivingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
